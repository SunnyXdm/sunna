; Sunna virtual display package. build.ps1 stamps the version placeholders.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
ClassVer=2.0
Provider=%Sunna%
PnpLockDown=1
CatalogFile=SunnaDisplay.cat
DriverVer=

[Manufacturer]
%Sunna%=SunnaModels,NTamd64.10.0...19041

[SunnaModels.NTamd64.10.0...19041]
%DisplayName%=SunnaInstall,SunnaDisplay
%DisplayName%=SunnaInstall,Root\SunnaDisplay

[SunnaInstall.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=SunnaFiles

[SunnaInstall.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=SunnaHardware

[SunnaHardware]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"SunnaDisplay-27e046a1-9ba8-4479-963f-cd0f642788c1"

[SunnaInstall.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[SunnaInstall.NT.Wdf]
UmdfService=SunnaDisplay,SunnaService
UmdfServiceOrder=SunnaDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[SunnaService]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\SunnaDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
SunnaFiles=13

[SunnaFiles]
SunnaDisplay.dll

[SourceDisksNames]
1=%MediaName%

[SourceDisksFiles]
SunnaDisplay.dll=1

[Strings]
Sunna="Sunna"
DisplayName="Sunna Display"
MediaName="Sunna Display driver package"
