#!/usr/bin/env bash
# sunna-host: share this Linux computer with the Sunna app.
#
#   sunna-host setup [options]  choose how to share, then start (and keep
#                               starting it at login or boot)
#   sunna-host link             the address and key to add this computer
#   sunna-host status           running? where? is someone connected?
#   sunna-host start | stop | restart
#   sunna-host logs             follow the host's log
#   sunna-host new-key          make a new key (update it in the app after)
#   sunna-host desktop-restart  restart the virtual desktop (closes its apps)
#   sunna-host desktop-stop     stop the host, the virtual desktop and its apps
#   sunna-host uninstall [--purge]
#   sunna-host report           a summary to send when asking for help
#                               (the key is left out)
#
# setup options:
#   --desktop        share the X11 desktop you're logged into
#   --virtual        share a separate desktop that runs without a screen
#                    (servers, or when your desktop is Wayland)
#   --listen WHERE   tailscale (default when Tailscale is up), lan, or IP[:PORT]
#   --name NAME      how this computer is called in the app (default: hostname)
#   --key KEY        use this key instead of making one
#   --size WxH       the virtual desktop's size (default 1710x1112)
#
# Settings live in ~/.config/sunna/host.env; edit it, then sunna-host restart.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sunna"
CONFIG="$CONFIG_DIR/host.env"
UNIT=sunna-host.service
DESKTOP_UNIT=sunna-desktop.service
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_FILE="$UNIT_DIR/$UNIT"
DESKTOP_UNIT_FILE="$UNIT_DIR/$DESKTOP_UNIT"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/sunna-host.desktop"
DEFAULT_PORT=48800
# Services and SSH sessions may not have these; the user manager does.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

SELF="$(readlink -f "$0")"
HERE="$(dirname "$SELF")"

die() { echo "sunna-host: $*" >&2; exit 1; }

sunnad_path() {
  if [ -x "$HERE/sunnad" ]; then echo "$HERE/sunnad"; else command -v sunnad || die "can't find sunnad"; fi
}

desktop_helper() {
  local candidate
  for candidate in "$HERE/../share/sunna/linux-desktop.sh" "${XDG_DATA_HOME:-$HOME/.local/share}/sunna/linux-desktop.sh" \
    /usr/share/sunna/linux-desktop.sh "$HERE/linux-desktop.sh"; do
    [ -x "$candidate" ] && { echo "$candidate"; return; }
  done
  die "can't find linux-desktop.sh (the virtual desktop helper)"
}

new_key() { head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

tailscale_ip() {
  command -v tailscale >/dev/null || return 0
  tailscale ip -4 2>/dev/null | head -1
}

lan_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

load() {
  [ -f "$CONFIG" ] || die "not set up yet: run sunna-host setup"
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG"
  set +a
  SUNNA_PORT="${SUNNA_PORT:-$DEFAULT_PORT}"
  SUNNA_LISTEN="${SUNNA_LISTEN:-tailscale}"
  SUNNA_MODE="${SUNNA_MODE:-virtual}"
  SUNNA_DISPLAY="${SUNNA_DISPLAY:-:40}"
  SUNNA_NAME="${SUNNA_NAME:-$(hostname)}"
}

# Where to listen, as IP:PORT; empty if that network isn't up (yet).
listen_address() {
  local ip=""
  case "$SUNNA_LISTEN" in
    tailscale) ip="$(tailscale_ip)" ;;
    lan) ip="$(lan_ip)" ;;
    *:*) echo "$SUNNA_LISTEN"; return ;;
    *) ip="$SUNNA_LISTEN" ;;
  esac
  [ -n "$ip" ] && echo "$ip:$SUNNA_PORT"
  return 0
}

systemctl_user() { systemctl --user "$@"; }

write_config() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  local tmp="$CONFIG.tmp"
  (
    umask 077
    cat >"$tmp" <<EOF
# Sunna host settings (sunna-host setup writes this). After editing:
#   sunna-host restart

# The key other computers need to connect. Keep it secret.
SUNNA_TOKEN=$SUNNA_TOKEN
# How this computer is called in the app.
SUNNA_NAME=$SUNNA_NAME
# Where to listen: tailscale (only your tailnet), lan (your local network),
# or an address like 192.168.1.20.
SUNNA_LISTEN=$SUNNA_LISTEN
SUNNA_PORT=$SUNNA_PORT
# desktop: the X11 desktop you're logged into.
# virtual: a separate desktop without a screen (servers; Wayland machines).
SUNNA_MODE=$SUNNA_MODE
# virtual mode: its display, size, and plasma or xfce (empty: what's installed).
SUNNA_DISPLAY=$SUNNA_DISPLAY
SUNNA_DESKTOP_SIZE=${SUNNA_DESKTOP_SIZE:-1710x1112}
SUNNA_DESKTOP=${SUNNA_DESKTOP:-}
EOF
  )
  mv "$tmp" "$CONFIG"
}

# The host, and in virtual mode the desktop it shares as its own service:
# restarting the host (an update) leaves the desktop and its apps alone,
# and stopping the desktop takes everything started in it along.
write_units() {
  mkdir -p "$UNIT_DIR"
  local needs=""
  if [ "$SUNNA_MODE" = virtual ]; then
    needs="Wants=$DESKTOP_UNIT
After=$DESKTOP_UNIT"
    cat >"$DESKTOP_UNIT_FILE" <<EOF
[Unit]
Description=Sunna's virtual desktop (a desktop without a screen, to share)

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=SUNNA_DESKTOP=${SUNNA_DESKTOP:-}
ExecStart=$(desktop_helper) $SUNNA_DISPLAY ${SUNNA_DESKTOP_SIZE:-1710x1112}
ExecStop=$(desktop_helper) stop $SUNNA_DISPLAY
EOF
  else
    rm -f "$DESKTOP_UNIT_FILE"
  fi
  cat >"$UNIT_FILE" <<EOF
[Unit]
Description=Sunna host: share this computer with the Sunna app
After=graphical-session.target
$needs

[Service]
ExecStart=$SELF run
Environment=NO_COLOR=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
EOF
}

# Desktop mode starts with your login, once the desktop is there.
write_autostart() {
  mkdir -p "$(dirname "$AUTOSTART")"
  cat >"$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=Sunna host
Comment=Share this desktop with the Sunna app
Exec=sh -c 'systemctl --user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE; systemctl --user restart $UNIT'
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
}

missing_for_virtual() {
  local missing=() session
  command -v Xvfb >/dev/null || missing+=(Xvfb)
  command -v dbus-run-session >/dev/null || missing+=(dbus-run-session)
  command -v xdpyinfo >/dev/null || missing+=(xdpyinfo)
  if [ -n "${SUNNA_DESKTOP:-}" ]; then
    session=$([ "$SUNNA_DESKTOP" = plasma ] && echo startplasma-x11 || echo startxfce4)
    command -v "$session" >/dev/null || missing+=("$session")
  elif ! command -v startplasma-x11 >/dev/null && ! command -v startxfce4 >/dev/null; then
    missing+=("a desktop (xfce4)")
  fi
  printf '%s\n' "${missing[@]}"
}

install_hint() {
  if command -v apt-get >/dev/null; then
    echo "  sudo apt install xvfb x11-utils dbus-x11 xfce4"
  elif command -v pacman >/dev/null; then
    echo "  sudo pacman -S xorg-server-xvfb xorg-xdpyinfo dbus xfce4"
  elif command -v dnf >/dev/null; then
    echo "  sudo dnf install xorg-x11-server-Xvfb xdpyinfo dbus-x11 @xfce-desktop-environment"
  fi
}

cmd_setup() {
  local mode="" listen="" name="" key="" size=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --desktop) mode=desktop ;;
      --virtual) mode=virtual ;;
      --listen) listen="${2:?--listen needs a value}"; shift ;;
      --name) name="${2:?--name needs a value}"; shift ;;
      --key) key="${2:?--key needs a value}"; shift ;;
      --size) size="${2:?--size needs a value}"; shift ;;
      *) die "unknown option $1 (see sunna-host help)" ;;
    esac
    shift
  done

  # Start from the current settings, if any.
  if [ -f "$CONFIG" ]; then load; fi
  local session="${XDG_SESSION_TYPE:-}"
  if [ -z "$mode" ]; then
    mode="${SUNNA_MODE:-}"
    if [ -z "$mode" ]; then
      if [ "$session" = x11 ] && [ -n "${DISPLAY:-}" ]; then mode=desktop; else mode=virtual; fi
    fi
  fi
  if [ "$mode" = desktop ] && [ "$session" = wayland ]; then
    die "this desktop is a Wayland session, which Sunna can't share yet. Log in with an X11 session (e.g. \"Ubuntu on Xorg\"), or use sunna-host setup --virtual"
  fi
  SUNNA_MODE="$mode"
  SUNNA_NAME="${name:-${SUNNA_NAME:-$(hostname)}}"
  SUNNA_PORT="${SUNNA_PORT:-$DEFAULT_PORT}"
  if [ -n "$listen" ]; then
    SUNNA_LISTEN="$listen"
  elif [ -z "${SUNNA_LISTEN:-}" ]; then
    if [ -n "$(tailscale_ip)" ]; then SUNNA_LISTEN=tailscale; else SUNNA_LISTEN=lan; fi
  fi
  if [ -n "$key" ]; then
    SUNNA_TOKEN="$key"
  elif [ -z "${SUNNA_TOKEN:-}" ]; then
    # Keep the key from an earlier scripts/run.sh setup (dogfood.env in
    # older versions), so saved computers still work.
    local old="$HOME/.sunna/sunna.env"
    [ -f "$old" ] || old="$HOME/.sunna/dogfood.env"
    if [ -f "$old" ] && grep -q '^SUNNA_TOKEN=' "$old"; then
      SUNNA_TOKEN="$(sed -n 's/^SUNNA_TOKEN=//p' "$old" | tail -1 | tr -d '"')"
      echo "Using the key from $old."
    else
      SUNNA_TOKEN="$(new_key)"
    fi
  fi
  [ -n "$size" ] && SUNNA_DESKTOP_SIZE="$size"
  if [ "$mode" = desktop ]; then
    SUNNA_DISPLAY="${DISPLAY:-:0}"
  elif [ -z "${SUNNA_DISPLAY:-}" ] || [ "${SUNNA_DISPLAY}" = "${DISPLAY:-none}" ]; then
    SUNNA_DISPLAY=:40
  fi

  if [ "$mode" = virtual ]; then
    local missing
    missing="$(missing_for_virtual)"
    if [ -n "$missing" ]; then
      echo "The virtual desktop needs: $(echo "$missing" | paste -sd, - | sed 's/,/, /g')"
      install_hint
      die "install those, then run sunna-host setup again"
    fi
  fi
  if [ "$SUNNA_LISTEN" = lan ]; then
    echo "Note: listening on your local network. Sunna's encryption doesn't check the host's identity"
    echo "      yet, so prefer Tailscale on networks you don't control (sunna-host setup --listen tailscale)."
  fi

  write_config
  write_units
  systemctl_user daemon-reload
  if [ "$mode" = desktop ]; then
    systemctl_user disable "$UNIT" >/dev/null 2>&1 || true
    write_autostart
    systemctl_user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE 2>/dev/null || true
  else
    rm -f "$AUTOSTART"
    systemctl_user enable "$UNIT" >/dev/null
    # Start at boot, not just at login (machines without a screen).
    loginctl enable-linger "$USER" >/dev/null 2>&1 ||
      echo "Note: couldn't enable starting at boot (loginctl enable-linger $USER); it starts when you log in."
  fi
  local started
  started="$(date +%s)"
  systemctl_user restart "$UNIT"

  echo "Starting…"
  local i
  for i in $(seq 60); do
    if journalctl --user -u "$UNIT" --since "@$started" -o cat 2>/dev/null | grep -q "sunnad listening"; then
      echo
      if [ "$mode" = virtual ]; then
        echo "  Sharing $SUNNA_NAME with Sunna: a virtual desktop on $SUNNA_DISPLAY (not your screen)."
        [ "$session" = wayland ] && echo "  (Your own desktop is Wayland, which Sunna can't share yet.)"
        local sound
        sound="$(sound_status)"
        case "$sound" in off*) echo "  Sound is $sound." ;; esac
      else
        echo "  Sharing $SUNNA_NAME's desktop ($SUNNA_DISPLAY) with Sunna."
      fi
      cmd_link
      return 0
    fi
    systemctl_user is-failed --quiet "$UNIT" && break
    sleep 0.5
  done
  echo "It didn't start. The last lines of its log:" >&2
  journalctl --user -u "$UNIT" -n 15 -o cat --no-pager >&2 || true
  exit 1
}

cmd_run() {
  load
  local addr="" i
  # At boot the network (and Tailscale) may come up after us.
  for i in $(seq 60); do
    addr="$(listen_address)"
    [ -n "$addr" ] && break
    sleep 2
  done
  [ -n "$addr" ] || die "no address to listen on (SUNNA_LISTEN=$SUNNA_LISTEN; is Tailscale up?)"
  if [ "$SUNNA_MODE" = virtual ]; then
    # sunna-desktop.service has started it (the unit waits for that).
    export DISPLAY="$SUNNA_DISPLAY"
    # Share the virtual desktop's own sound output (linux-desktop.sh).
    export SUNNA_AUDIO_SOURCE="${SUNNA_AUDIO_SOURCE:-sunna_desktop_${SUNNA_DISPLAY#:}.monitor}"
  else
    [ "${XDG_SESSION_TYPE:-}" = wayland ] &&
      die "the desktop is a Wayland session, which Sunna can't share yet: log in with X11, or run sunna-host setup --virtual"
    export DISPLAY="${DISPLAY:-$SUNNA_DISPLAY}"
  fi
  exec "$(sunnad_path)" --source screen --listen "$addr" --name "$SUNNA_NAME"
}

cmd_link() {
  load
  local addr host port link
  addr="$(listen_address)"
  [ -n "$addr" ] || die "no address yet (SUNNA_LISTEN=$SUNNA_LISTEN; is Tailscale up?)"
  host="${addr%:*}"
  port="${addr##*:}"
  link="sunna://$host"
  [ "$port" = "$DEFAULT_PORT" ] || link="$link:$port"
  link="$link?key=$SUNNA_TOKEN"
  echo
  echo "    Address   $host$([ "$port" = "$DEFAULT_PORT" ] || echo ":$port")"
  echo "    Key       $SUNNA_TOKEN"
  echo
  echo "  In the Sunna app, choose Add a Computer and paste:"
  echo "    $link"
  echo
}

# Whether sessions get sound, and if not, what to do.
sound_status() {
  if [ -n "${SUNNA_AUDIO_SOURCE:-}" ]; then
    echo "on: $SUNNA_AUDIO_SOURCE"
  elif ! command -v pactl >/dev/null; then
    # linux-desktop.sh needs pactl to give a virtual desktop its sound output.
    if [ "$SUNNA_MODE" = virtual ]; then
      echo "off: needs pactl (Debian and Ubuntu: sudo apt install pulseaudio-utils), then sunna-host desktop-restart"
    else
      echo "unknown (install pactl to check)"
    fi
  elif ! pactl info >/dev/null 2>&1; then
    echo "off: no sound server (PulseAudio or PipeWire) is running"
  elif [ "$SUNNA_MODE" != virtual ]; then
    echo "on: what's playing on this computer"
  elif pactl list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "sunna_desktop_${SUNNA_DISPLAY#:}"; then
    echo "on: this desktop's own output"
  elif systemctl_user is-active --quiet "$DESKTOP_UNIT"; then
    echo "off until sunna-host desktop-restart (this desktop started before Sunna had sound; restarting closes its apps)"
  else
    echo "on when the desktop starts"
  fi
}

cmd_status() {
  load
  local state since
  state="$(systemctl_user is-active "$UNIT" 2>/dev/null || true)"
  echo "Sunna host: $state"
  echo "  Name       $SUNNA_NAME"
  echo "  Mode       $SUNNA_MODE ($SUNNA_DISPLAY)"
  echo "  Listening  $(listen_address || true)"
  echo "  Sound      $(sound_status)"
  if [ "$state" = active ]; then
    # The host logs a line every second while a viewer is connected.
    if journalctl --user -u "$UNIT" --since "-5s" -o cat 2>/dev/null | grep -q "host window"; then
      echo "  Viewer     connected"
    else
      echo "  Viewer     none"
    fi
  fi
}

cmd_new_key() {
  load
  SUNNA_TOKEN="$(new_key)"
  write_config
  systemctl_user restart "$UNIT"
  echo "New key made. Computers that saved the old one need this one (edit them in the app)."
  cmd_link
}

cmd_uninstall() {
  systemctl_user disable --now "$UNIT" >/dev/null 2>&1 || true
  systemctl_user stop "$DESKTOP_UNIT" >/dev/null 2>&1 || true
  rm -f "$UNIT_FILE" "$DESKTOP_UNIT_FILE" "$AUTOSTART"
  systemctl_user daemon-reload 2>/dev/null || true
  if [ "${1:-}" = --purge ]; then
    rm -rf "$CONFIG_DIR"
    echo "Removed the settings (and the key)."
  fi
  # A per-user install (scripts/install-host-linux.sh) put these here.
  local data="${XDG_DATA_HOME:-$HOME/.local/share}/sunna"
  if [ "$HERE" = "$HOME/.local/bin" ]; then
    rm -f "$HOME/.local/bin/sunnad" "$data/linux-desktop.sh"
    rmdir "$data" 2>/dev/null || true
    echo "Uninstalled. (Settings kept in $CONFIG_DIR unless you used --purge.)"
    rm -f "$SELF"
  else
    echo "Stopped and removed the service. Remove the package with your package manager (e.g. sudo apt remove sunna-host)."
  fi
}

cmd_report() {
  local key="" sunnad
  [ -f "$CONFIG" ] && key="$(sed -n 's/^SUNNA_TOKEN=//p' "$CONFIG" | tail -1)"
  sunnad="$(sunnad_path 2>/dev/null)" || sunnad=""
  {
    echo "Sunna host report, $(date -u '+%Y-%m-%d %H:%M UTC')"
    echo
    echo "System     $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}"), kernel $(uname -r), $(uname -m)"
    echo "CPU        $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | xargs) ($(nproc) threads)"
    if command -v nvidia-smi >/dev/null && nvidia-smi >/dev/null 2>&1; then
      echo "GPU        $(nvidia-smi --query-gpu=name,driver_version --format=csv,noheader | head -1) (NVIDIA driver)"
    else
      local gpu
      gpu="$(lspci 2>/dev/null | grep -i -E 'vga|3d controller' | cut -d: -f3- | head -2 | xargs || true)"
      echo "GPU        ${gpu:-none found (or lspci missing)}"
    fi
    echo "Desktop    ${XDG_SESSION_TYPE:-no graphical session here} ${XDG_CURRENT_DESKTOP:+($XDG_CURRENT_DESKTOP)}"
    if [ -n "$sunnad" ]; then
      echo "Video      default codec $("$sunnad" --help 2>/dev/null | sed -n 's/.*\[default: \(hevc\|h264\|raw\)\].*/\1/p' | head -1) (hevc only with a working NVIDIA encoder)"
    fi
    echo "nasm       $(command -v nasm >/dev/null && echo installed || echo "not installed (a host built without it encodes 3-4x slower)")"
    echo
    if [ -f "$CONFIG" ]; then cmd_status; else echo "Not set up yet: run sunna-host setup."; fi
    if command -v tailscale >/dev/null; then
      echo
      echo "Tailscale peers (direct is good; relay means slower):"
      tailscale status 2>/dev/null | awk '!/^#/ && NF { $1 = ""; $3 = ""; print }' | head -20
    fi
    echo
    echo "Recent log:"
    journalctl --user -u "$UNIT" -n 40 -o cat --no-pager 2>/dev/null
  } | if [ -n "$key" ]; then sed "s/$key/<key>/g"; else cat; fi
}

case "${1:-help}" in
  setup) shift; cmd_setup "$@" ;;
  run) cmd_run ;;
  link) cmd_link ;;
  status) cmd_status ;;
  start | stop | restart) systemctl_user "$1" "$UNIT" ;;
  logs) journalctl --user -u "$UNIT" -f -n 50 -o cat ;;
  new-key) cmd_new_key ;;
  desktop-stop) systemctl_user stop "$UNIT" "$DESKTOP_UNIT" ;;
  desktop-restart) systemctl_user restart "$DESKTOP_UNIT" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  report) cmd_report ;;
  help | -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$SELF" ;;
  *) die "unknown command $1 (sunna-host help)" ;;
esac
