FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential pkg-config nasm python3 libwebkit2gtk-4.1-dev libxdo-dev libssl-dev libasound2-dev libudev-dev patchelf xz-utils git && rm -rf /var/lib/apt/lists/*
# Minimal LGPL FFmpeg, no GPL/nonfree components, and no distro-specific codec
# dependency closure. Ship matching source and configure flags with releases.
ARG FFMPEG_VERSION=6.1.2
RUN curl -fsSL https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz -o /tmp/ffmpeg.tar.xz && \
    mkdir /tmp/ffmpeg && tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg --strip-components=1 && \
    cd /tmp/ffmpeg && ./configure --prefix=/opt/ffmpeg --disable-autodetect --disable-everything --enable-decoder=h264,hevc --enable-parser=h264,hevc --enable-shared --disable-static --disable-programs --disable-doc --disable-network --disable-avdevice --disable-avfilter --disable-avformat --disable-swresample --disable-swscale --enable-pic && \
    make -j4 && make install && mkdir -p /opt/ffmpeg/share/source && cp /tmp/ffmpeg.tar.xz /opt/ffmpeg/share/source/ && cp COPYING.LGPLv2.1 /opt/ffmpeg/share/source/ && rm -rf /tmp/ffmpeg /tmp/ffmpeg.tar.xz
ENV PKG_CONFIG_PATH=/opt/ffmpeg/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/ffmpeg/lib
