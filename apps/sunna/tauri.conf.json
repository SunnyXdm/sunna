{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunna",
  "version": "0.0.1",
  "identifier": "dev.sunna.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sunna",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
