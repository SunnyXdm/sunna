{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunna",
  "version": "0.0.1",
  "identifier": "dev.sunna.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sunna",
        "width": 900,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
